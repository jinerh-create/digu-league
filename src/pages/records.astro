---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { computeRecords, type RecordGroup } from '../lib/records';

const runtime = (Astro.locals as Record<string, unknown>).runtime as { env: { DB: D1Database } } | undefined;
let groups: RecordGroup[] = [];
let totalTracked = 0;
if (runtime?.env?.DB) {
  try { const r = await computeRecords(runtime.env.DB); groups = r.groups; totalTracked = r.totalTracked; } catch { /* render empty on failure */ }
}
const initials = (name: string) => name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
const totalRecords = groups.reduce((n, g) => n + g.records.length, 0);
---
<BaseLayout title="Records" activeTab="home">
  <div class="container">
    <div class="rec-header">
      <h1>🏆 DIGU League Records</h1>
      <p class="sub">{totalRecords} official records · {totalTracked} currently held</p>
    </div>

    <div class="rec-nav-wrap">
      <nav class="rec-nav" id="recNav">
        {groups.map((g, i) => (
          <a href={`#${g.title}`} data-sec={g.title} style={`--i:${i}`}>
            <span class="rn-emoji">{g.emoji}</span><span>{g.title}</span>
          </a>
        ))}
      </nav>
    </div>

    <script is:inline>
      (function () {
        const nav = document.getElementById('recNav');
        if (!nav) return;
        const links = [...nav.querySelectorAll('a')];
        const secs = links.map(a => document.getElementById(a.dataset.sec)).filter(Boolean);

        function activate(el) {
          links.forEach(l => l.classList.toggle('on', l === el));
          // Keep the active pill in view — on a phone the strip is wider than the
          // screen, so the current section would otherwise scroll out of sight.
          el.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }

        links.forEach(a => a.addEventListener('click', (e) => {
          const target = document.getElementById(a.dataset.sec);
          if (!target) return;
          e.preventDefault();
          activate(a);
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', '#' + a.dataset.sec);
        }));

        // Scroll-spy: whichever section owns the upper third of the screen wins.
        if ('IntersectionObserver' in window && secs.length) {
          const io = new IntersectionObserver((entries) => {
            const vis = entries.filter(en => en.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
            if (!vis) return;
            const link = links.find(l => l.dataset.sec === vis.target.id);
            if (link && !link.classList.contains('on')) activate(link);
          }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });
          secs.forEach(s => io.observe(s));
        }
        if (links[0]) links[0].classList.add('on');

        /* Auto-sliding strip. It cycles the pills so every section announces itself
           even when the strip is wider than the screen. Any touch, drag or hover
           stops it for 6s — an auto-scroll that fights the user is worse than none. */
        let idx = 0, paused = false, resumeAt = 0;
        const nudge = () => {
          idx = (idx + 1) % links.length;
          links[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        };
        const pause = () => { paused = true; resumeAt = Date.now() + 6000; };
        ['pointerdown', 'wheel', 'touchstart', 'mouseenter'].forEach(ev =>
          nav.addEventListener(ev, pause, { passive: true }));

        setInterval(() => {
          if (paused && Date.now() > resumeAt) paused = false;
          if (paused || document.hidden) return;
          if (nav.scrollWidth <= nav.clientWidth + 4) return;   // nothing to slide
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          nudge();
        }, 2600);
      })();
    </script>

    {groups.map(g => (
      <section class="rec-group" id={g.title}>
        <h2 class="rec-group-title">{g.emoji} {g.title}</h2>
        <div class="rec-grid">
          {g.records.map(r => (
            <div class={`rec-card${!r.tracked ? ' untracked' : ''}${r.holderId ? ' held' : ''}`}>
              <div class="rec-top">
                <span class="rec-emoji">{r.emoji}</span>
                <div class="rec-title">
                  <b>{r.name}</b>
                </div>
                <span class="rec-value">{r.value}</span>
              </div>
              <div class="rec-holder">
                {r.tracked && r.holderId ? (
                  <a class="rec-who" href={`/players/${r.holderId}`}>
                    <span class="rec-face">
                      {r.photo ? <img src={r.photo} alt={r.holder} /> : <span class="rec-init">{initials(r.holder || '?')}</span>}
                    </span>
                    <span class="rec-name">{r.holder}</span>
                  </a>
                ) : (
                  <div class="rec-none">🔒 Unclaimed</div>
                )}
                {/* Justification is folded away so the tile stays to the three things
                    that matter at a glance: record, holder, number. <details> keeps it
                    keyboard-accessible with no JavaScript. */}
                <details class="rec-why">
                  <summary>View</summary>
                  <div class="rec-why-body">
                    {r.detail && <p>{r.detail}</p>}
                    {!r.tracked && <p>{r.note || 'Not yet tracked.'}</p>}
                    {r.tracked && r.holderId && <p>Held by <b>{r.holder}</b> with <b>{r.value}</b>. Recalculated from every completed match each time this page loads.</p>}
                  </div>
                </details>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .rec-header { margin-bottom: .8rem; }
  .rec-header h1 { font-size: 1.5rem; }
  .rec-header .sub { color: var(--text-muted); font-size: .82rem; margin-top: .2rem; }
  /* Sticky section strip. The wrapper carries the sticky position and the edge
     fades, so the fades stay pinned while the pills scroll underneath them —
     doing both on one element makes the mask scroll away with the content. */
  .rec-nav-wrap {
    position: sticky; top: 0; z-index: 5;
    margin-bottom: 1rem; padding: .5rem 0 .55rem;
    background: linear-gradient(180deg, var(--bg) 72%, transparent);
  }
  .rec-nav-wrap::before, .rec-nav-wrap::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: 26px; pointer-events: none; z-index: 2;
  }
  .rec-nav-wrap::before { left: 0;  background: linear-gradient(90deg, var(--bg), transparent); }
  .rec-nav-wrap::after  { right: 0; background: linear-gradient(270deg, var(--bg), transparent); }

  .rec-nav {
    display: flex; gap: .4rem; overflow-x: auto; scrollbar-width: none;
    scroll-snap-type: x proximity; padding: 2px 4px;
  }
  .rec-nav::-webkit-scrollbar { display: none; }

  .rec-nav a {
    position: relative; flex-shrink: 0; scroll-snap-align: center;
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .45rem .85rem; border-radius: 999px;
    font-size: .78rem; font-weight: 700; white-space: nowrap; text-decoration: none;
    color: var(--text-secondary);
    background: linear-gradient(160deg, rgba(255,255,255,0.05), var(--card));
    border: 1px solid var(--border);
    transition: color .18s ease, border-color .18s ease, background .18s ease, transform .18s ease;
    /* staggered slide-in on load */
    animation: rn-in .34s cubic-bezier(.22,.9,.3,1) backwards;
    animation-delay: calc(var(--i, 0) * 45ms);
  }
  .rec-nav a .rn-emoji { font-size: .95rem; line-height: 1; transition: transform .18s ease; }
  .rec-nav a:hover { color: #D4AF37; border-color: rgba(212,175,55,0.5); transform: translateY(-1px); }
  .rec-nav a:hover .rn-emoji { transform: scale(1.12); }

  /* Active pill — gold, lifted, with a soft glow so it reads at a glance. */
  .rec-nav a.on {
    color: #1a1000; border-color: #E8C84A;
    background: linear-gradient(135deg, #b8922a 0%, #d4af37 52%, #e8c84a 100%);
    box-shadow: 0 3px 12px rgba(212,175,55,0.34);
  }
  .rec-nav a.on .rn-emoji { transform: scale(1.1); }

  @keyframes rn-in { from { opacity: 0; transform: translateX(14px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .rec-nav a { animation: none; transition: none; }
  }
  .rec-group { margin-bottom: 1.6rem; scroll-margin-top: 3.2rem; }
  .rec-group-title { font-size: 1.1rem; margin-bottom: .7rem; color: var(--text-primary); }
  .rec-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: .6rem; }
  .rec-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: .7rem .8rem; }
  .rec-card.held { border-color: rgba(212,175,55,0.4); background: linear-gradient(160deg, rgba(212,175,55,0.06), var(--card)); }
  .rec-card.untracked { opacity: .62; }
  .rec-top { display: flex; align-items: center; gap: .55rem; }
  .rec-emoji { font-size: 1.3rem; flex-shrink: 0; }
  .rec-title { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  /* One line on every screen — a record name that wraps makes the grid ragged and
     pushes the number out of alignment. Long names ellipsize instead. */
  /* Gold for the record, silver for whoever holds it — the same hierarchy the
     trophies use, so the two never read as equal weight. */
  .rec-name { color: #C6CDD6; font-weight: 700; text-shadow: 0 0 8px rgba(198,205,214,0.25); }
  .rec-title b {
    font-size: .86rem; color: #D4AF37; font-weight: 700; line-height: 1.2;
    text-shadow: 0 0 10px rgba(212,175,55,0.28);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;
  }
  .rec-top { min-width: 0; }
  .rec-title small { font-size: .64rem; color: var(--text-muted); }
  .rec-value { font-family: var(--font-heading); font-weight: 800; font-size: .95rem; color: #D4AF37; font-variant-numeric: tabular-nums; flex-shrink: 0; }
  .rec-holder { margin-top: .55rem; padding-top: .5rem; border-top: 1px solid var(--border); }
  .rec-who { display: flex; align-items: center; gap: .5rem; text-decoration: none; }

  /* Justification disclosure */
  .rec-holder { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .rec-why { margin-left: auto; }
  .rec-why > summary {
    list-style: none; cursor: pointer; user-select: none;
    padding: .22rem .6rem; border-radius: 999px;
    border: 1px solid var(--border); background: var(--card-raised, transparent);
    font-size: .64rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    color: var(--text-secondary); transition: color .15s, border-color .15s;
  }
  .rec-why > summary::-webkit-details-marker { display: none; }
  .rec-why > summary:hover { color: #D4AF37; border-color: rgba(212,175,55,0.55); }
  .rec-why[open] > summary { color: #D4AF37; border-color: rgba(212,175,55,0.55); }
  .rec-why[open] > summary::after { content: ' ▲'; }
  .rec-why:not([open]) > summary::after { content: ' ▼'; }
  .rec-why-body {
    flex-basis: 100%; width: 100%; margin-top: .5rem; padding-top: .5rem;
    border-top: 1px dashed var(--border);
    font-size: .7rem; color: var(--text-secondary); line-height: 1.45;
    animation: rec-why-in .18s ease;
  }
  .rec-why-body p { margin: 0 0 .35rem; }
  .rec-why-body p:last-child { margin-bottom: 0; }
  @keyframes rec-why-in { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: none; } }
  .rec-face { width: 30px; height: 30px; border-radius: 50%; overflow: hidden; flex-shrink: 0; background: var(--card-raised); display: grid; place-items: center; border: 1.5px solid rgba(212,175,55,0.5); }
  .rec-face img { width: 100%; height: 100%; object-fit: cover; }
  .rec-init { font-size: .68rem; font-weight: 800; color: #D4AF37; font-family: var(--font-heading); }
  .rec-name { flex: 1; font-weight: 700; font-size: .86rem; color: var(--text-primary); }
  .rec-tag { font-size: .52rem; font-weight: 800; letter-spacing: .08em; color: #D4AF37; background: rgba(212,175,55,0.14); border: 1px solid rgba(212,175,55,0.3); padding: .15rem .4rem; border-radius: 5px; }
  .rec-none { font-size: .68rem; color: var(--text-muted); font-weight: 600; }
</style>
